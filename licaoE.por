programa
{
	
	funcao inicio()
	{
		inteiro num, soma

	num=1
     soma = 0

	faca{

		se (num%2==00)
		escreva(num,"\n")
		num = num+1
		soma = soma +num
	}

	enquanto (num<=500)

	escreva("A soma dos números pares é ", soma)
	}
	
}
