programa
{
	
	funcao inicio()
	{
	inteiro num
num =1
	enquanto (num <= 10){
	
	escreva (num, " x 8 = ", num * 8, "\n")
	num = num + 1
	}
	escreva("Fim do programa")
	
	}
	
	
}
