programa
{
	
	funcao inicio()
	{
	inteiro numero 

	escreva("numeros divisiveis por 4 menor que 200", "\n")

	para (numero=1;numero<=200;numero++){
		se (numero%4==0){
			escreva(numero, "-", "\n")
		}
	}
	}
}
