programa
{
	
	funcao inicio()
	{
		inteiro num, num_quadrado
		num = 0
		num_quadrado = num*num

		para (num =15;num<=200;num++){
			num_quadrado = num*num
			escreva("o quadrado  de ", num, " e ", num_quadrado, "\n")
		}
	}
}
