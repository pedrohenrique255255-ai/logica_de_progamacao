programa
{
	
	funcao inicio()
	{
	real n1, n2
escreva("digite o primeiro valor")
leia(n1)

escreva("digite o segundo valor")
leia(n2)

enquanto (n2==0){
	escreva("digite o segundo valor")
	leia(n2)
}
	escreva("O resultado é", n1/n2)
	}
}
