programa
{
	
	funcao inicio()
	{
	inteiro num, soma

	num = 1
	soma = 0

	enquanto (num<=500){
		se (num%2==0)
		escreva(num, "\n")
		num++
		soma = soma + num
	}
	num++
	}
	
}
