programa
{
	
	funcao inicio()
	{
	real num1, nume2, resultado, valor
faca{
escreva("digite o primeiro numero")
leia(num1)

escreva("digite o segundo numero")
leia(nume2)
}
 
enquanto (nume2 ==0)
resultado= num1/nume2
escreva("a divisão dos valores é", resultado)
	
	
	}
}
