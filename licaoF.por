programa
{
	
	funcao inicio()
	{
		inteiro n1, n2, media
		
         n1=0
         n2=0 
         
		faca{
			escreva("digite a nota da primeira avalação", "\n")
		leia(n1)

		}

		enquanto (n1<0 ou n1>10)
escreva("digite a nota da primeira avalação", n1, "\n")

faca{
	escreva("digite a nota da sugunda avaliação")
		leia(n2)
}
	enquanto (n2<0 ou n2>10)	
escreva("digite a nota da primeira avalação ", n2,"\n")


media = (n1+n2)/2
escreva("A media do aluno foi de ", media)


	
	}
	


	


	
}
